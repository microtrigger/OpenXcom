{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "OpenXcom paired benchmark row",
  "description": "GPL-3.0-or-later; created 2026-10-10. See project LICENSE.txt. Measurement rows are not completion certificates.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "run_id": {
      "description": "local anonymized ordinal",
      "type": "string"
    },
    "pair_id": {
      "description": "matched task/save/repetition identifier",
      "type": "string"
    },
    "task_id": {
      "description": "frozen manifest task",
      "type": "string"
    },
    "arm": {
      "description": "gui or mcp",
      "type": "string",
      "enum": [
        "gui",
        "mcp"
      ]
    },
    "order": {
      "description": "AB or BA",
      "type": "string",
      "enum": [
        "AB",
        "BA"
      ]
    },
    "scope": {
      "description": "offline_codec, observation, end_to_end",
      "type": "string",
      "enum": [
        "offline_codec",
        "observation",
        "end_to_end"
      ]
    },
    "repetition": {
      "description": "integer",
      "type": "integer",
      "minimum": 0
    },
    "success": {
      "description": "boolean",
      "type": "boolean"
    },
    "failure_category": {
      "description": "null or controlled label",
      "type": [
        "string",
        "null"
      ]
    },
    "accuracy": {
      "description": "number 0..1",
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "parity_pass": {
      "description": "boolean",
      "type": "boolean"
    },
    "freshness_verified": {
      "description": "boolean",
      "type": "boolean"
    },
    "wall_ms": {
      "description": "number or null",
      "type": [
        "number",
        "null"
      ],
      "minimum": 0
    },
    "tool_elapsed_ms": {
      "description": "number or null",
      "type": [
        "number",
        "null"
      ],
      "minimum": 0
    },
    "model_elapsed_ms": {
      "description": "number or null",
      "type": [
        "number",
        "null"
      ],
      "minimum": 0
    },
    "tool_calls_capture": {
      "description": "integer",
      "type": "integer",
      "minimum": 0
    },
    "tool_calls_action": {
      "description": "integer",
      "type": "integer",
      "minimum": 0
    },
    "tool_calls_observe": {
      "description": "integer",
      "type": "integer",
      "minimum": 0
    },
    "tool_calls_verify": {
      "description": "integer",
      "type": "integer",
      "minimum": 0
    },
    "retries": {
      "description": "integer",
      "type": "integer",
      "minimum": 0
    },
    "request_payload_bytes": {
      "description": "integer or null",
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0
    },
    "response_payload_bytes": {
      "description": "integer or null",
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0
    },
    "image_encoded_bytes": {
      "description": "integer or null",
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0
    },
    "image_base64_bytes": {
      "description": "integer or null",
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0
    },
    "input_tokens": {
      "description": "integer or null",
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0
    },
    "output_tokens": {
      "description": "integer or null",
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0
    },
    "cached_tokens": {
      "description": "integer or null",
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0
    },
    "reasoning_tokens": {
      "description": "integer or null",
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0
    },
    "cache_write_tokens": {
      "description": "integer or null",
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0
    },
    "usage_complete": {
      "description": "boolean",
      "type": "boolean"
    },
    "game_cpu_ms": {
      "description": "number or null",
      "type": [
        "number",
        "null"
      ],
      "minimum": 0
    },
    "adapter_cpu_ms": {
      "description": "number or null",
      "type": [
        "number",
        "null"
      ],
      "minimum": 0
    },
    "encoder_cpu_ms": {
      "description": "number or null",
      "type": [
        "number",
        "null"
      ],
      "minimum": 0
    },
    "runner_cpu_ms": {
      "description": "number or null",
      "type": [
        "number",
        "null"
      ],
      "minimum": 0
    },
    "game_peak_rss_bytes": {
      "description": "integer or null",
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0
    },
    "adapter_peak_rss_bytes": {
      "description": "integer or null",
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0
    },
    "encoder_peak_rss_bytes": {
      "description": "integer or null",
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0
    },
    "estimated_cost": {
      "description": "number or null",
      "type": [
        "number",
        "null"
      ],
      "minimum": 0
    },
    "bill_cost": {
      "description": "number or null",
      "type": [
        "number",
        "null"
      ],
      "minimum": 0
    },
    "currency": {
      "description": "string or null",
      "type": [
        "string",
        "null"
      ]
    },
    "model_compute": {
      "description": "null unless instrumented",
      "type": [
        "number",
        "null"
      ],
      "minimum": 0
    },
    "model": {
      "description": "exact permitted model/version",
      "type": "string"
    },
    "settings_manifest_hash": {
      "description": "hash of nonsecret fixed settings",
      "type": "string"
    },
    "cache_condition": {
      "description": "declared condition; measured cached token counters separate",
      "type": "string"
    }
  },
  "required": [
    "run_id",
    "pair_id",
    "task_id",
    "arm",
    "order",
    "scope",
    "repetition",
    "success",
    "failure_category",
    "accuracy",
    "parity_pass",
    "freshness_verified",
    "wall_ms",
    "tool_elapsed_ms",
    "model_elapsed_ms",
    "tool_calls_capture",
    "tool_calls_action",
    "tool_calls_observe",
    "tool_calls_verify",
    "retries",
    "request_payload_bytes",
    "response_payload_bytes",
    "image_encoded_bytes",
    "image_base64_bytes",
    "input_tokens",
    "output_tokens",
    "cached_tokens",
    "reasoning_tokens",
    "cache_write_tokens",
    "usage_complete",
    "game_cpu_ms",
    "adapter_cpu_ms",
    "encoder_cpu_ms",
    "runner_cpu_ms",
    "game_peak_rss_bytes",
    "adapter_peak_rss_bytes",
    "encoder_peak_rss_bytes",
    "estimated_cost",
    "bill_cost",
    "currency",
    "model_compute",
    "model",
    "settings_manifest_hash",
    "cache_condition"
  ]
}
